# Telegram
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=YourBotName  # без @ — для ссылки регистрации мастера в боте
MINIAPP_URL=https://yourdomain.com/app

# Database
POSTGRES_USER=tg_studio
POSTGRES_PASSWORD=secret
POSTGRES_DB=tg_studio
DATABASE_URL=postgresql+asyncpg://tg_studio:secret@postgres:5432/tg_studio

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Public URL for email verification links
PUBLIC_URL=https://yourdomain.com

# LLM (OpenAI-compatible: OpenAI, Gemini, и т.д.)
# Для OpenAI: LLM_BASE_URL не указывать, LLM_MODEL=gpt-4o-mini
# Для Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# JWT
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_EMAIL_VERIFY_EXPIRE_HOURS=24

# SMTP (Gmail App Password — не обычный пароль аккаунта)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_NAME=TG Studio

# Google Calendar
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials.json
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/admin/google-calendar/callback

# App
DEBUG=false
ALLOWED_HOSTS=yourdomain.com

# HttpOnly JWT cookies (логин / регистрация / refresh)
# В проде за HTTPS включите COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com
